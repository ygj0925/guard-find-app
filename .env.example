# 客户端环境基址。复制为 .env 后按环境填写;真实地址不入库(规格: 集中式环境配置)。
# 这三项由 app.config.ts 读入并写进 expo.extra,lib/env.ts 再消费。

# 后端网关:dev 指向 http://<host>:8082;staging/production 必须是 HTTPS。
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8082

# 实时通道:留空则由 API 基址把 http->ws 推导出来。生产必须 WSS。
EXPO_PUBLIC_WS_BASE_URL=

# development | staging | production
EXPO_PUBLIC_ENV_NAME=development

# 合规告知文本版本,提交时随 CaseReq.agreementVersion 上送。
EXPO_PUBLIC_AGREEMENT_VERSION=v1

# Android 模拟器访问宿主机用 10.0.2.2;iOS 模拟器/真机与鸿蒙设备直接填局域网 IP。
